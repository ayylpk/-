/* jianqie - 浅色主题 */

QWidget {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #1f2328;
}

QLabel#SectionHint {
    color: #6e7781;
    font-size: 12px;
}

/* ---------- 列表窗口 ---------- */

/* 窗口的底色和边框不在这里 —— 由 MainWindow::paintEvent 直接画。
   之前放在 QSS 里、配合半透明窗口时压根没画出来，整个窗口是透的。
   这里只负责窗口内部子控件的样式。 */

/* 勾选栏做成透明的：这样窗口背景不透明度调低时，
   整块区域会一起变透，不会留下一条突兀的实心条。 */
#MarkBar {
    background-color: transparent;
    border-top: 1px solid #dde3ea;
}

#MarkLabel {
    color: #57606a;
    font-size: 12px;
}

#ListHeader {
    color: #57606a;
    font-size: 12px;
    padding: 8px 12px 4px 12px;
}

#ListHint {
    color: #8c959f;
    font-size: 11px;
    padding: 4px 12px 8px 12px;
}

#HistoryList {
    background-color: transparent;
    border: none;
    outline: none;
}

#HistoryList::item {
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid transparent;
}

#HistoryList::item:hover {
    background-color: #f3f5f8;
}

#HistoryList::item:selected {
    background-color: #e7f0fb;
    border: 1px solid #b6d4f5;
    color: #0b4a8f;
}

#HistoryList::item:disabled {
    color: #8c959f;
}

/* ---------- 设置窗口 ---------- */

#SettingsWindow {
    background-color: #f6f8fa;
}

#SettingsTitle {
    font-size: 17px;
    font-weight: 500;
    padding: 4px 2px 2px 2px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #57606a;
    font-weight: 500;
}

/* ---------- 通用控件 ---------- */

QPushButton {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #f3f4f6;
}

QPushButton:pressed {
    background-color: #e9ecef;
}

QPushButton:disabled {
    color: #8c959f;
    background-color: #f6f8fa;
}

QPushButton#DangerButton {
    color: #b42318;
    border-color: #f0c2bd;
}

QPushButton#DangerButton:hover {
    background-color: #fdf3f2;
}

QComboBox, QSpinBox, QLineEdit, QKeySequenceEdit {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: #cfe3fa;
    selection-color: #0b4a8f;
}

QComboBox:focus, QSpinBox:focus, QLineEdit:focus, QKeySequenceEdit:focus {
    border: 1px solid #4a90d9;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    selection-background-color: #e7f0fb;
    selection-color: #0b4a8f;
    outline: none;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #c6cdd5;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #4a90d9;
    border-color: #4a90d9;
}

/* ---------- 滚动条 ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #d0d7de;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #b4bcc4;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #d0d7de;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
    width: 0px;
}

/* ---------- 菜单 / 提示 ---------- */

QMenu {
    background-color: #ffffff;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    padding: 5px;
}

/* 左右留白给足，尤其是右边 —— 之前 22px 太挤，菜单看着又窄又憋 */
QMenu::item {
    padding: 7px 40px 7px 16px;
    border-radius: 4px;
    min-width: 80px;
}

QMenu::item:selected {
    background-color: #e7f0fb;
    color: #0b4a8f;
}

QMenu::separator {
    height: 1px;
    background: #e4e8ec;
    margin: 4px 8px;
}

QToolTip {
    background-color: #24292f;
    color: #ffffff;
    border: none;
    padding: 4px 6px;
}
